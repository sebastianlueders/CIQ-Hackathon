  "turnkey_fuzzfile": "# ==============================================================================\n# Alchemy Turnkey Autoresearch Workflow (ingest -> train -> eval -> serve)\n# ==============================================================================\n# Cluster        : ciq-gb10-team3 | VAST Storage Provisioner: use=team3\n# Nodes          : gb10-node-01 (gb10-01), gb10-node-02 (gb10-02)\n# Node Hardware  : 1x NVIDIA-GB10 (Blackwell, sm_121), 20c arm64, 127.9 GiB/node\n# Per-Node Alloc : 8 cores, 96GiB RAM, 1x nvidia.com/gpu\n# Shared Storage : VAST persistent volume 'runs' (use: team3) mounted at /vast\n# Base Model     : Qwen/Qwen2.5-Coder-1.5B-Instruct (MoE, 151,936 vocab, 2.9 GB BF16)\n# Dataset        : lammps-c-gpu-simulation-corpus-enterprise-benchm (whole-file sealed held-out split; raw data never left VAST)\n#\n# Measured Autoresearch Decisions:\n#   [Stage A - Winning LoRA Recipe]\n#     rank=32, alpha=64, lr=0.000188,\n#     modules=['q_proj', 'k_proj', 'v_proj', 'o_proj', 'gate_proj', 'up_proj', 'down_proj'], seq_len=2048\n#     Held-out perplexity: 6.506 (base) -> 4.230 (fine-tuned)\n#\n#   [Stage B - Winning Training Performance Config (company-preset-gb10-qwen25-1.5b-fast-demo)]\n#     nodes=1, micro_batch=8, grad_accum=2,\n#     activation_checkpointing=False,\n#     sm_121 kernels: chunked_ce=True, grouped_moe=False, fused_lora=True\n#     Throughput: 2027.0 -> 4756.4 tok/s (2.35x)\n#\n#   [Stage C - Winning vLLM Serving Config (nvfp4-2replicas-tp1)]\n#     precision=NVFP4, replicas=2, tensor_parallel=1,\n#     max_num_seqs=96, low_prec_decode_kernel=True\n#     Serving throughput: 401.8 -> 3460.3 tok/s\n#\n# Launch end-to-end on CIQ Fuzzball (Team 20):\n#   fuzzball workflow validate final-crucible-workflow.yaml\n#   fuzzball workflow start final-crucible-workflow.yaml --name lammps-c-gpu-simulation-corpus-enterprise-benchm-qwen2-5-coder-1-5b-instruct-team20\n# ==============================================================================\n\nversion: v4\nvolumes:\n  vast:\n    name: runs\n    use: team3\njobs:\n  ingest-lammps:\n    image:\n      uri: docker://python:3.12-slim\n    mounts:\n      /vast:\n        volume: vast\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    - PYTHONPATH=/vast/crucible-src/src\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 16GiB\n    policy:\n      timeout:\n        execute: 30m\n    script: \"#!/bin/bash\\nset -euo pipefail\\nmkdir -p /tmp/home\\npip install --quiet\\\n      \\ --no-cache-dir pyyaml pydantic numpy httpx\\nif ! python3 -c \\\"import crucible\\\"\\\n      \\ 2>/dev/null && [ ! -d \\\"/vast/crucible-src/src/crucible\\\" ]; then\\n  python3\\\n      \\ -c \\\"import urllib.request,tarfile,os; os.makedirs('/vast/crucible-src',exist_ok=True);\\\n      \\ urllib.request.urlretrieve('https://codeload.github.com/sebastianlueders/CIQ-Hackathon/tar.gz/seb-branch','/tmp/c.tgz')\\\"\\\n      \\n  tar -xzf /tmp/c.tgz -C \\\"/vast/crucible-src\\\" --strip-components=1\\nfi\\n\\\n      python3 -m crucible.cli ingest \\\\\\n  --source-dir /vast/data/builtin-lammps-cpp-bench\\\n      \\ \\\\\\n  --output-dir /vast/data/lammps-c-gpu-simulation-corpus-enterprise-benchm-packed\\\n      \\ \\\\\\n  --seq-len 2048\\n\"\n  train-lora:\n    image:\n      uri: docker://nvcr.io/nvidia/pytorch:26.10-py3\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: ingest-lammps\n      status: FINISHED\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    - PYTHONPATH=/vast/crucible-src/src\n    - NCCL_DEBUG=WARN\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 96GiB\n      devices:\n        nvidia.com/gpu: 1\n    policy:\n      timeout:\n        execute: 12h\n      retry:\n        attempts: 2\n    script: \"#!/bin/bash\\nset -euo pipefail\\nmkdir -p /tmp/home\\npython3 -m crucible.trainer.lora_trainer\\\n      \\ \\\\\\n  --trial-id production-lora \\\\\\n  --base-model-dir /vast/models/Qwen/Qwen2.5-Coder-1.5B-Instruct\\\n      \\ \\\\\\n  --processed-data-dir /vast/data/lammps-c-gpu-simulation-corpus-enterprise-benchm-packed\\\n      \\ \\\\\\n  --output-dir /vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-qwen2-5-coder-1-5b-instruct-production\\\n      \\ \\\\\\n  --max-steps 140 \\\\\\n  --recipe-json '{\\\"lora_alpha\\\": 64, \\\"lora_rank\\\"\\\n      : 32, \\\"lr\\\": 0.000188, \\\"seq_len\\\": 2048, \\\"target_modules\\\": [\\\"q_proj\\\",\\\n      \\ \\\"k_proj\\\", \\\"v_proj\\\", \\\"o_proj\\\", \\\"gate_proj\\\", \\\"up_proj\\\", \\\"down_proj\\\"\\\n      ], \\\"warmup_ratio\\\": 0.05}' \\\\\\n  --perf-json '{\\\"activation_checkpointing\\\"\\\n      : false, \\\"grad_accum_steps\\\": 2, \\\"label\\\": \\\"company-preset-gb10-qwen25-1.5b-fast-demo\\\"\\\n      , \\\"micro_batch_size\\\": 8, \\\"nodes\\\": 1, \\\"use_chunked_ce_kernel\\\": true, \\\"\\\n      use_fused_lora_kernel\\\": true, \\\"use_grouped_moe_kernel\\\": false}'\\n\"\n  eval-held-out:\n    image:\n      uri: docker://nvcr.io/nvidia/pytorch:26.10-py3\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: train-lora\n      status: FINISHED\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 96GiB\n      devices:\n        nvidia.com/gpu: 1\n    policy:\n      timeout:\n        execute: 45m\n    script: \"#!/bin/bash\\nset -euo pipefail\\npython3 - <<'PY'\\nimport json, pathlib,\\\n      \\ sys\\nsummary = json.loads(pathlib.Path('/vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-qwen2-5-coder-1-5b-instruct-production/summary.json').read_text())\\n\\\n      ceiling = 4.3353\\nppl = float(summary['held_out_perplexity'])\\nprint(f'Verified\\\n      \\ held-out perplexity: {ppl:.4f} (ceiling: {ceiling:.4f})')\\nif ppl > ceiling:\\n\\\n      \\    sys.exit('Held-out quality floor check failed \\u2014 aborting promotion\\\n      \\ to serving.')\\nPY\\n\"\nservices:\n  serve-vllm:\n    image:\n      uri: docker://vllm/vllm-openai:v0.33.0\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: eval-held-out\n      status: FINISHED\n    env:\n    - HOME=/tmp\n    - PYTHONUNBUFFERED=1\n    - CRUCIBLE_USE_LOW_PREC_DECODE=1\n    - CRUCIBLE_TARGET_REPLICAS=2\n    command:\n    - python3\n    - -m\n    - vllm.entrypoints.openai.api_server\n    - --model\n    - /vast/models/Qwen/Qwen2.5-Coder-1.5B-Instruct\n    - --enable-lora\n    - --lora-modules\n    - crucible-tuned=/vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-qwen2-5-coder-1-5b-instruct-production/lora_adapter\n    - --tensor-parallel-size\n    - '1'\n    - --max-num-seqs\n    - '96'\n    - --attention-backend\n    - TRITON_ATTN\n    - --port\n    - '8000'\n    - --quantization\n    - modelopt\n    - --kv-cache-dtype\n    - fp8\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 96GiB\n      devices:\n        nvidia.com/gpu: 1\n    persist: true\n    network:\n      ports:\n      - name: http\n        port: 8000\n      endpoints:\n      - name: crucible-coder-api\n        port-name: http\n        protocol: http\n        type: subdomain\n        scope: group\n"
}