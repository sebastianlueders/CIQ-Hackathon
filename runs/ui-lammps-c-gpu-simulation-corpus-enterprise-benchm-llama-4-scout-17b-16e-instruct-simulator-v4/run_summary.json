  "turnkey_fuzzfile": "# ==============================================================================\n# Crucible Turnkey Autoresearch Workflow (ingest -> train -> eval -> serve)\n# ==============================================================================\n# Cluster        : ciq-gb10-team3 | VAST Storage Provisioner: use=team3\n# Nodes          : gb10-node-01 (gb10-01), gb10-node-02 (gb10-02)\n# Node Hardware  : 1x NVIDIA-GB10 (Blackwell, sm_121), 20c arm64, 127.9 GiB/node\n# Per-Node Alloc : 8 cores, 96GiB RAM, 1x nvidia.com/gpu\n# Shared Storage : VAST persistent volume 'runs' (use: team3) mounted at /vast\n# Base Model     : meta-llama/Llama-4-Scout-17B-16E-Instruct (MoE, 202,048 vocab, 209.3 GB BF16)\n# Dataset        : lammps-c-gpu-simulation-corpus-enterprise-benchm (whole-file sealed held-out split; raw data never left VAST)\n#\n# Measured Autoresearch Decisions:\n#   [Stage A - Winning LoRA Recipe]\n#     rank=16, alpha=32, lr=0.00012,\n#     modules=['q_proj', 'k_proj', 'v_proj', 'o_proj', 'up_proj', 'down_proj'], seq_len=2048\n#     Held-out perplexity: 6.848 (base) -> 9999.000 (fine-tuned)\n#\n#   [Stage B - Winning Training Performance Config (pytorch-fsdp-2node)]\n#     nodes=2, micro_batch=2, grad_accum=4,\n#     activation_checkpointing=True,\n#     sm_121 kernels: chunked_ce=False, grouped_moe=False, fused_lora=False\n#     Throughput: 0.0 -> 0.0 tok/s (0.00x)\n#\n#   [Stage C - Winning vLLM Serving Config (nvfp4-2replicas-tp1)]\n#     precision=NVFP4, replicas=2, tensor_parallel=1,\n#     max_num_seqs=64, low_prec_decode_kernel=True\n#     Serving throughput: 610.7 -> 3152.9 tok/s\n#\n# Launch end-to-end on CIQ Fuzzball (Team 20):\n#   fuzzball workflow validate final-crucible-workflow.yaml\n#   fuzzball workflow start final-crucible-workflow.yaml --name lammps-c-gpu-simulation-corpus-enterprise-benchm-llama-4-scout-17b-16e-instruct-team20\n# ==============================================================================\n\nversion: v4\nvolumes:\n  vast:\n    name: runs\n    use: team3\njobs:\n  ingest-lammps:\n    image:\n      uri: docker://python:3.12-slim\n    mounts:\n      /vast:\n        volume: vast\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    - PYTHONPATH=/vast/crucible-src/src\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 16GiB\n    policy:\n      timeout:\n        execute: 30m\n    script: \"#!/bin/bash\\nset -euo pipefail\\nmkdir -p /tmp/home\\npip install --quiet\\\n      \\ --no-cache-dir pyyaml pydantic numpy httpx\\nif ! python3 -c \\\"import crucible\\\"\\\n      \\ 2>/dev/null && [ ! -d \\\"/vast/crucible-src/src/crucible\\\" ]; then\\n  python3\\\n      \\ -c \\\"import urllib.request,tarfile,os; os.makedirs('/vast/crucible-src',exist_ok=True);\\\n      \\ urllib.request.urlretrieve('https://codeload.github.com/sebastianlueders/CIQ-Hackathon/tar.gz/seb-branch','/tmp/c.tgz')\\\"\\\n      \\n  tar -xzf /tmp/c.tgz -C \\\"/vast/crucible-src\\\" --strip-components=1\\nfi\\n\\\n      python3 -m crucible.cli ingest \\\\\\n  --source-dir /vast/data/builtin-lammps-cpp-bench\\\n      \\ \\\\\\n  --output-dir /vast/data/lammps-c-gpu-simulation-corpus-enterprise-benchm-packed\\\n      \\ \\\\\\n  --seq-len 2048\\n\"\n  train-lora:\n    image:\n      uri: docker://nvcr.io/nvidia/pytorch:26.10-py3\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: ingest-lammps\n      status: FINISHED\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    - PYTHONPATH=/vast/crucible-src/src\n    - NCCL_DEBUG=WARN\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 80GiB\n      devices:\n        nvidia.com/gpu: 1\n    policy:\n      timeout:\n        execute: 12h\n      retry:\n        attempts: 2\n    script: \"#!/bin/bash\\nset -euo pipefail\\nmkdir -p /tmp/home\\nSELF=$(hostname);\\\n      \\ FQDN=$(hostname -f 2>/dev/null || echo \\\"$SELF\\\")\\nHOSTS=$(echo \\\"${MULTINODE_HOSTLIST_NOSLOTS:-$SELF}\\\"\\\n      \\ | tr ',' '\\\\n' | sort)\\nMASTER=${MN_MASTER:-$(echo \\\"$HOSTS\\\" | head -1)}\\n\\\n      RANK=$(echo \\\"$HOSTS\\\" | grep -nx -e \\\"$SELF\\\" -e \\\"$FQDN\\\" | head -1 | cut\\\n      \\ -d: -f1 || echo 1)\\nNODE_RANK=${MN_NODE_RANK:-$(( ${RANK:-1} - 1 ))}\\nif [\\\n      \\ -z \\\"${MN_NODE_RANK:-}\\\" ] && [ -n \\\"${MULTINODE_SSH_WRAPPER:-}\\\" ]; then\\n\\\n      \\  HEAD_IP=${MULTINODE_NODE_IP:-$(getent hosts \\\"$SELF\\\" | awk '{print $1}'\\\n      \\ | head -1)}\\n  i=0\\n  for h in $HOSTS; do\\n    [ \\\"$h\\\" = \\\"$SELF\\\" ] || [\\\n      \\ \\\"$h\\\" = \\\"$FQDN\\\" ] && continue\\n    i=$((i + 1))\\n    \\\"$MULTINODE_SSH_WRAPPER\\\"\\\n      \\ \\\"$h\\\" \\\"MN_NODE_RANK=$i MN_MASTER=$HEAD_IP PYTHONPATH=/vast/crucible-src/src\\\n      \\ HOME=/tmp/home python3 -m torch.distributed.run --nnodes 2 --nproc-per-node\\\n      \\ 1 --node-rank $i --master-addr $HEAD_IP --master-port 29500 -m crucible.trainer.lora_trainer\\\n      \\ --trial-id production-lora --base-model-dir /vast/models/meta-llama/Llama-4-Scout-17B-16E-Instruct\\\n      \\ --processed-data-dir /vast/data/lammps-c-gpu-simulation-corpus-enterprise-benchm-packed\\\n      \\ --output-dir /vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-llama-4-scout-17b-16e-instruct-production\\\n      \\ --max-steps 320 --recipe-json '{\\\"lora_alpha\\\": 32, \\\"lora_rank\\\": 16, \\\"\\\n      lr\\\": 0.00012, \\\"seq_len\\\": 2048, \\\"target_modules\\\": [\\\"q_proj\\\", \\\"k_proj\\\"\\\n      , \\\"v_proj\\\", \\\"o_proj\\\", \\\"up_proj\\\", \\\"down_proj\\\"], \\\"warmup_ratio\\\": 0.05}'\\\n      \\ --perf-json '{\\\"activation_checkpointing\\\": true, \\\"grad_accum_steps\\\": 4,\\\n      \\ \\\"label\\\": \\\"pytorch-fsdp-2node\\\", \\\"micro_batch_size\\\": 2, \\\"nodes\\\": 2,\\\n      \\ \\\"use_chunked_ce_kernel\\\": false, \\\"use_fused_lora_kernel\\\": false, \\\"use_grouped_moe_kernel\\\"\\\n      : false}'\\\" > /tmp/rank$i.log 2>&1 &\\n  done\\n  NODE_RANK=0; MASTER=$HEAD_IP\\n\\\n      fi\\npython3 -m torch.distributed.run \\\\\\n  --nnodes 2 \\\\\\n  --nproc-per-node\\\n      \\ 1 \\\\\\n  --node-rank \\\"$NODE_RANK\\\" \\\\\\n  --master-addr \\\"$MASTER\\\" \\\\\\n  --master-port\\\n      \\ 29500 \\\\\\n  -m crucible.trainer.lora_trainer \\\\\\n  --trial-id production-lora\\\n      \\ \\\\\\n  --base-model-dir /vast/models/meta-llama/Llama-4-Scout-17B-16E-Instruct\\\n      \\ \\\\\\n  --processed-data-dir /vast/data/lammps-c-gpu-simulation-corpus-enterprise-benchm-packed\\\n      \\ \\\\\\n  --output-dir /vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-llama-4-scout-17b-16e-instruct-production\\\n      \\ \\\\\\n  --max-steps 320 \\\\\\n  --recipe-json '{\\\"lora_alpha\\\": 32, \\\"lora_rank\\\"\\\n      : 16, \\\"lr\\\": 0.00012, \\\"seq_len\\\": 2048, \\\"target_modules\\\": [\\\"q_proj\\\", \\\"\\\n      k_proj\\\", \\\"v_proj\\\", \\\"o_proj\\\", \\\"up_proj\\\", \\\"down_proj\\\"], \\\"warmup_ratio\\\"\\\n      : 0.05}' \\\\\\n  --perf-json '{\\\"activation_checkpointing\\\": true, \\\"grad_accum_steps\\\"\\\n      : 4, \\\"label\\\": \\\"pytorch-fsdp-2node\\\", \\\"micro_batch_size\\\": 2, \\\"nodes\\\":\\\n      \\ 2, \\\"use_chunked_ce_kernel\\\": false, \\\"use_fused_lora_kernel\\\": false, \\\"\\\n      use_grouped_moe_kernel\\\": false}'\\n\"\n    multinode:\n      nodes: 2\n      implementation: generic\n  eval-held-out:\n    image:\n      uri: docker://nvcr.io/nvidia/pytorch:26.10-py3\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: train-lora\n      status: FINISHED\n    env:\n    - HOME=/tmp/home\n    - PYTHONUNBUFFERED=1\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 96GiB\n      devices:\n        nvidia.com/gpu: 1\n    policy:\n      timeout:\n        execute: 45m\n    script: \"#!/bin/bash\\nset -euo pipefail\\npython3 - <<'PY'\\nimport json, pathlib,\\\n      \\ sys\\nsummary = json.loads(pathlib.Path('/vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-llama-4-scout-17b-16e-instruct-production/summary.json').read_text())\\n\\\n      ceiling = 10248.9750\\nppl = float(summary['held_out_perplexity'])\\nprint(f'Verified\\\n      \\ held-out perplexity: {ppl:.4f} (ceiling: {ceiling:.4f})')\\nif ppl > ceiling:\\n\\\n      \\    sys.exit('Held-out quality floor check failed \\u2014 aborting promotion\\\n      \\ to serving.')\\nPY\\n\"\nservices:\n  serve-vllm:\n    image:\n      uri: docker://vllm/vllm-openai:v0.33.0\n    mounts:\n      /vast:\n        volume: vast\n    depends-on:\n    - name: eval-held-out\n      status: FINISHED\n    env:\n    - HOME=/tmp\n    - PYTHONUNBUFFERED=1\n    - CRUCIBLE_USE_LOW_PREC_DECODE=1\n    - CRUCIBLE_TARGET_REPLICAS=2\n    command:\n    - python3\n    - -m\n    - vllm.entrypoints.openai.api_server\n    - --model\n    - /vast/models/meta-llama/Llama-4-Scout-17B-16E-Instruct\n    - --enable-lora\n    - --lora-modules\n    - crucible-tuned=/vast/runs/lammps-c-gpu-simulation-corpus-enterprise-benchm-llama-4-scout-17b-16e-instruct-production/lora_adapter\n    - --tensor-parallel-size\n    - '1'\n    - --max-num-seqs\n    - '64'\n    - --attention-backend\n    - TRITON_ATTN\n    - --port\n    - '8000'\n    - --quantization\n    - modelopt\n    - --kv-cache-dtype\n    - fp8\n    resource:\n      cpu:\n        cores: 8\n      memory:\n        size: 96GiB\n      devices:\n        nvidia.com/gpu: 1\n    persist: true\n    network:\n      ports:\n      - name: http\n        port: 8000\n      endpoints:\n      - name: crucible-coder-api\n        port-name: http\n        protocol: http\n        type: subdomain\n        scope: group\n"
}